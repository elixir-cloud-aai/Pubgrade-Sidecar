# Only send the files needed at runtime to the build context
*
!app/
!pyproject.toml
!uv.lock

# Exclude caches and local files within the included paths
**/__pycache__
**/*.py[cod]
**/*.egg-info
# Written by the app next to the API spec at startup, also by local test runs; a
# copy in the image couldn't be overwritten by the user that OpenShift assigns
**/*.modified.yaml
# Local secrets (e.g., `.env`, `.env.local`) must never reach the build, also
# not within the included paths
**/.env*
# Other common names of secret files
**/*.env
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/*.p12
**/*.pfx
**/.git-credentials
**/.pypirc
**/credentials*.json
**/.netrc

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["imageWait"],
  "properties": {
    "appName": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "targetDeployments": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$"
      }
    },
    "deploymentLabel": {"type": "string"},
    "refuseDowngrades": {"type": "boolean"},
    "allowedTags": {"type": "string"},
    "accessToken": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "registryCredentials": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "imageWait": {
      "type": "object",
      "required": ["retries", "interval"],
      "properties": {
        "retries": {"type": "integer", "minimum": 0, "maximum": 100},
        "interval": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "insecureRegistries": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+(:[0-9]+)?$"}
    },
    "hostName": {"type": "string"},
    "podSecurityContext": {
      "type": "object",
      "properties": {"seccompProfile": {"type": "object"}}
    },
    "securityContext": {
      "type": "object",
      "properties": {"seccompProfile": {"type": "object"}}
    }
  }
}
